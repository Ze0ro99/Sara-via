# ==========================================
# SARA VIA — TESTNET ENVIRONMENT
# ==========================================

# Server
PORT=3000
HOST=0.0.0.0

# Application
APP_NAME=SARA VIA
APP_ENV=testnet

# Pi Network
PI_API_BASE=https://api.minepi.com/v2

# IMPORTANT:
# Put your real Pi Server API Key here
# ONLY in the real .env file.
#
# NEVER publish your real API key to GitHub.
PI_API_KEY=YOUR_PI_SERVER_API_KEY_HERE

# Optional travel providers (test credentials only)
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_ROUTES_API_KEY=

# Future integrations - keep secrets server-side
HOTEL_PROVIDER_BASE_URL=
HOTEL_PROVIDER_API_KEY=
TOUR_PROVIDER_BASE_URL=
TOUR_PROVIDER_API_KEY=
LOGISTICS_PROVIDER_BASE_URL=
LOGISTICS_PROVIDER_API_KEY=
